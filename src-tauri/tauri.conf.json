{
  "productName": "PR Buddy",
  "version": "0.3.0",
  "identifier": "com.prbuddy.dev",
  "build": {
    "beforeDevCommand": "npm run vite:dev",
    "beforeBuildCommand": "npm run vite:build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "PR Buddy",
        "width": 380,
        "height": 520,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https://avatars.githubusercontent.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libayatana-appindicator3-1"]
      },
      "rpm": {
        "epoch": 0,
        "release": "1",
        "depends": ["libayatana-appindicator-gtk3"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENEOEM4RUVCQkFDQkQyRTAKUldUZzBzdTY2NDZNellYQWl5QVNLYVRITlNZaGdNQzYvTlVCQ2ZNcXpkRkQ0OHlhRUM4VjdWZ2MK",
      "endpoints": [
        "https://github.com/coder/pr-buddy/releases/latest/download/latest.json"
      ]
    }
  }
}
